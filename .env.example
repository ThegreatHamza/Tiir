# Frontend (safe to expose): Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Seed script only (scripts/seed.mjs). NEVER prefix with VITE_ and never
# commit a real value: the service role key bypasses Row Level Security.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
